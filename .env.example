# Firebase web app configuration (safe for client — these are public identifiers, not secrets)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=ilevaro.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ilevaro
VITE_FIREBASE_STORAGE_BUCKET=ilevaro.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Application
VITE_APP_NAME=ILEVARO
VITE_DEFAULT_CURRENCY=NGN
VITE_DEFAULT_TIMEZONE=Africa/Lagos
